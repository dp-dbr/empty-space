# Copy to .env and adjust. Never commit real secrets.
DP_AC_ENV=dev
DP_AC_DATABASE_URL=sqlite:///./var/dpac.db
DP_AC_DATA_DIR=./var
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
DP_AC_VAULT_KEYS=
DP_AC_SECRET_KEY=change-me
DP_AC_PUBLIC_BASE_URL=http://localhost:8000
# LLM providers (selected per AgentDefinition; optional global override)
DP_AC_DEFAULT_LLM_PROVIDER=fake
DP_AC_DEFAULT_LLM_MODEL=
DP_AC_ANTHROPIC_API_KEY=
DP_AC_OPENAI_API_KEY=
DP_AC_OPENAI_BASE_URL=
# Observability
DP_AC_OTLP_ENDPOINT=
